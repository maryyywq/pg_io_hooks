diff --git a/src/test/modules/test_smgr_hooks/t/001_transform.pl b/src/test/modules/test_smgr_hooks/t/001_transform.pl
new file mode 100644
index 00000000000..b39b2e8f670
--- /dev/null
+++ b/src/test/modules/test_smgr_hooks/t/001_transform.pl
@@ -0,0 +1,76 @@
+# Copyright (c) 2024, PostgreSQL Global Development Group
+
+# Test the smgr I/O transformation hooks through test_smgr_hooks: the data
+# must be stored transformed, read back correctly, survive crash recovery,
+# and be unreadable without the module.
+
+use strict;
+use warnings FATAL => 'all';
+use PostgreSQL::Test::Cluster;
+use PostgreSQL::Test::Utils;
+use Test::More;
+
+my $marker = 'smgr-hooks-plaintext-marker';
+
+# Return true if the relation's main fork file contains the marker as is.
+sub raw_has_marker
+{
+	my ($node, $rel) = @_;
+	my $path = $node->safe_psql('postgres', "SELECT pg_relation_filepath('$rel')");
+	my $data = slurp_file($node->data_dir . '/' . $path);
+	return index($data, $marker) >= 0;
+}
+
+my $setup = qq{
+CREATE TABLE t (id int, v text);
+INSERT INTO t SELECT g, '$marker ' || g FROM generate_series(1, 2000) g;
+CREATE INDEX t_v ON t (v);
+CHECKPOINT;
+};
+
+# Baseline: without the module the marker is visible in the files, so the
+# checks below are meaningful.
+my $plain = PostgreSQL::Test::Cluster->new('plain');
+$plain->init(extra => ['--data-checksums']);
+$plain->start;
+$plain->safe_psql('postgres', $setup);
+ok(raw_has_marker($plain, 't'), 'baseline: table file contains the marker');
+ok(raw_has_marker($plain, 't_v'), 'baseline: index file contains the marker');
+$plain->stop;
+
+# With the module.
+my $node = PostgreSQL::Test::Cluster->new('hooked');
+$node->init(extra => ['--data-checksums']);
+$node->append_conf('postgresql.conf', "shared_preload_libraries = 'test_smgr_hooks'");
+$node->start;
+$node->safe_psql('postgres', $setup);
+
+ok(!raw_has_marker($node, 't'), 'table file does not contain the marker');
+ok(!raw_has_marker($node, 't_v'), 'index file does not contain the marker');
+
+is($node->safe_psql('postgres', "SELECT count(*) FROM t WHERE v LIKE '$marker%'"),
+	'2000', 'rows are read back correctly');
+
+# Evict everything from shared buffers by restarting, then read again.
+$node->restart;
+is($node->safe_psql('postgres', "SELECT sum(id) FROM t"),
+	'2001000', 'rows are read back correctly after restart');
+
+# Crash recovery: replayed full-page images go through the same hooks.
+$node->safe_psql('postgres', "INSERT INTO t SELECT g, '$marker ' || g FROM generate_series(2001, 3000) g");
+$node->stop('immediate');
+$node->start;
+is($node->safe_psql('postgres', "SELECT count(*) FROM t"),
+	'3000', 'rows survive crash recovery');
+ok(!raw_has_marker($node, 't'), 'table file still does not contain the marker');
+$node->stop;
+
+# Without the module the transformed pages must be rejected.
+$node->append_conf('postgresql.conf', "shared_preload_libraries = ''");
+$node->start;
+my ($ret, $stdout, $stderr) = $node->psql('postgres', "SELECT count(*) FROM t");
+isnt($ret, 0, 'reading transformed data without the module fails');
+like($stderr, qr/invalid page|page verification failed/, 'failure is reported as a bad page');
+$node->stop;
+
+done_testing();
diff --git a/src/test/modules/test_smgr_hooks/test_smgr_hooks.c b/src/test/modules/test_smgr_hooks/test_smgr_hooks.c
new file mode 100644
index 00000000000..1dac56147d7
--- /dev/null
+++ b/src/test/modules/test_smgr_hooks/test_smgr_hooks.c
@@ -0,0 +1,158 @@
+/*--------------------------------------------------------------------------
+ *
+ * test_smgr_hooks.c
+ *		Test module for the smgr I/O transformation hooks.
+ *
+ * The module XORs every non-empty block of a user relation with a key byte
+ * derived from the block number when it is written, and does the reverse
+ * after it is read.  All-zero blocks are left alone in both directions: they
+ * are produced by relation extension without any hook call and must be read
+ * back as empty pages.
+ *
+ * Portions Copyright (c) 1996-2024, PostgreSQL Global Development Group
+ * Portions Copyright (c) 1994, Regents of the University of California
+ *
+ * IDENTIFICATION
+ *		src/test/modules/test_smgr_hooks/test_smgr_hooks.c
+ *
+ * -------------------------------------------------------------------------
+ */
+
+#include "postgres.h"
+
+#include "access/transam.h"
+#include "fmgr.h"
+#include "miscadmin.h"
+#include "storage/bufmgr.h"
+#include "storage/smgr.h"
+
+PG_MODULE_MAGIC;
+
+void		_PG_init(void);
+
+/* Previous hook values, to chain to them */
+static smgr_read_hook_type prev_read_hook = NULL;
+static smgr_write_hook_type prev_write_hook = NULL;
+static smgr_extend_hook_type prev_extend_hook = NULL;
+
+/*
+ * Output buffers of the write and extend hooks.  They are static, so that no
+ * memory is allocated while writing, and aligned for direct I/O.
+ */
+static PGIOAlignedBlock write_blocks[MAX_IO_COMBINE_LIMIT];
+static const void *write_ptrs[MAX_IO_COMBINE_LIMIT];
+static PGIOAlignedBlock extend_block;
+
+/* Only transform relations created after initdb, which ran without us. */
+static bool
+is_transformed(RelFileLocator rlocator)
+{
+	return rlocator.relNumber >= FirstNormalObjectId;
+}
+
+static bool
+block_is_zero(const void *block)
+{
+	const size_t *p = (const size_t *) block;
+
+	for (size_t i = 0; i < BLCKSZ / sizeof(size_t); i++)
+	{
+		if (p[i] != 0)
+			return false;
+	}
+	return true;
+}
+
+/* XOR is its own inverse, so the same function encodes and decodes. */
+static void
+xor_block(const void *src, void *dst, BlockNumber blocknum)
+{
+	const unsigned char *s = (const unsigned char *) src;
+	unsigned char *d = (unsigned char *) dst;
+	unsigned char key = (unsigned char) (0x5A + blocknum);
+
+	for (int i = 0; i < BLCKSZ; i++)
+		d[i] = s[i] ^ key;
+}
+
+/*
+ * The read hook may run in a critical section and in another process than
+ * the one that started the read (see smgr.h), so it only uses its arguments.
+ */
+static BlockNumber
+test_read_hook(RelFileLocatorBackend rlocator, ForkNumber forknum,
+			   BlockNumber blocknum, void **buffers, BlockNumber nblocks)
+{
+	if (prev_read_hook)
+		nblocks = prev_read_hook(rlocator, forknum, blocknum, buffers, nblocks);
+
+	if (!is_transformed(rlocator.locator))
+		return nblocks;
+
+	for (BlockNumber i = 0; i < nblocks; i++)
+	{
+		if (block_is_zero(buffers[i]))
+			continue;
+		xor_block(buffers[i], buffers[i], blocknum + i);
+	}
+	return nblocks;
+}
+
+static const void **
+test_write_hook(SMgrRelation reln, ForkNumber forknum, BlockNumber blocknum,
+				const void **buffers, BlockNumber nblocks)
+{
+	if (prev_write_hook)
+		buffers = prev_write_hook(reln, forknum, blocknum, buffers, nblocks);
+
+	if (!is_transformed(reln->smgr_rlocator.locator))
+		return buffers;
+
+	if (nblocks > MAX_IO_COMBINE_LIMIT)
+		elog(ERROR, "too many blocks in one write: %u", nblocks);
+
+	for (BlockNumber i = 0; i < nblocks; i++)
+	{
+		if (block_is_zero(buffers[i]))
+			write_ptrs[i] = buffers[i];
+		else
+		{
+			xor_block(buffers[i], write_blocks[i].data, blocknum + i);
+			write_ptrs[i] = write_blocks[i].data;
+		}
+	}
+	return write_ptrs;
+}
+
+static const void *
+test_extend_hook(SMgrRelation reln, ForkNumber forknum, BlockNumber blocknum,
+				 const void *buffer)
+{
+	if (prev_extend_hook)
+		buffer = prev_extend_hook(reln, forknum, blocknum, buffer);
+
+	if (!is_transformed(reln->smgr_rlocator.locator) || block_is_zero(buffer))
+		return buffer;
+
+	xor_block(buffer, extend_block.data, blocknum);
+	return extend_block.data;
+}
+
+void
+_PG_init(void)
+{
+	/*
+	 * The on-disk format depends on the hooks, so they must be active in
+	 * every process from the start.
+	 */
+	if (!process_shared_preload_libraries_in_progress)
+		ereport(ERROR,
+				(errmsg("test_smgr_hooks must be loaded via shared_preload_libraries")));
+
+	prev_read_hook = smgr_read_hook;
+	smgr_read_hook = test_read_hook;
+	prev_write_hook = smgr_write_hook;
+	smgr_write_hook = test_write_hook;
+	prev_extend_hook = smgr_extend_hook;
+	smgr_extend_hook = test_extend_hook;
+}
