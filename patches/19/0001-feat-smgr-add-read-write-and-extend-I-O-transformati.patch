From 82f10696dc99202bc46084412bf9b85fc2efd4d7 Mon Sep 17 00:00:00 2001
From: Maria <mk902589@yandex.ru>
Date: Fri, 13 Nov 2026 00:17:55 +0700
Subject: [PATCH 1/6] feat(smgr): add read, write and extend I/O transformation
 hooks

Add smgr_read_hook, smgr_write_hook and smgr_extend_hook, called from
smgrreadv(), smgrwritev() and smgrextend().  An extension can use them
to transform block data on its way to and from the storage manager, for
example to implement transparent page encryption.

The buffer manager reads blocks asynchronously, with smgrstartreadv().
For those reads the read hook is called from a new AIO completion
callback, PGAIO_HCB_SMGR_READV, which smgrstartreadv() registers when
the hook is set.  It runs after the smgr implementation's callback and
before the buffer manager's, so the checksums are verified after the
hook.  As it may run in a critical section and in another process, the
read hook gets the relation file locator instead of an SMgrRelation and
reports failures through its return value instead of raising an error.

The hooks follow the usual chaining convention.  Page checksums are
computed before the write hook and verified after the read hook, so
hooks always see the plaintext page.  With no hook registered the
behavior is unchanged.
---
 src/backend/storage/aio/aio_callback.c |   2 +
 src/backend/storage/smgr/smgr.c        | 142 +++++++++++++++++++++++++
 src/include/storage/aio.h              |   2 +
 src/include/storage/smgr.h             |  87 +++++++++++++++
 4 files changed, 233 insertions(+)

diff --git a/src/backend/storage/aio/aio_callback.c b/src/backend/storage/aio/aio_callback.c
index 206b81f5028..74d12f8a1a7 100644
--- a/src/backend/storage/aio/aio_callback.c
+++ b/src/backend/storage/aio/aio_callback.c
@@ -42,6 +42,8 @@ static const PgAioHandleCallbacksEntry aio_handle_cbs[] = {
 
 	CALLBACK_ENTRY(PGAIO_HCB_MD_READV, aio_md_readv_cb),
 
+	CALLBACK_ENTRY(PGAIO_HCB_SMGR_READV, aio_smgr_readv_cb),
+
 	CALLBACK_ENTRY(PGAIO_HCB_SHARED_BUFFER_READV, aio_shared_buffer_readv_cb),
 
 	CALLBACK_ENTRY(PGAIO_HCB_LOCAL_BUFFER_READV, aio_local_buffer_readv_cb),
diff --git a/src/backend/storage/smgr/smgr.c b/src/backend/storage/smgr/smgr.c
index 5391640d861..050af0f988e 100644
--- a/src/backend/storage/smgr/smgr.c
+++ b/src/backend/storage/smgr/smgr.c
@@ -67,6 +67,7 @@
 #include "lib/ilist.h"
 #include "miscadmin.h"
 #include "storage/aio.h"
+#include "storage/aio_internal.h"
 #include "storage/bufmgr.h"
 #include "storage/ipc.h"
 #include "storage/md.h"
@@ -161,7 +162,17 @@ static HTAB *SMgrRelationHash = NULL;
 
 static dlist_head unpinned_relns;
 
+/* Storage I/O transformation hooks, see smgr.h */
+smgr_read_hook_type smgr_read_hook = NULL;
+smgr_write_hook_type smgr_write_hook = NULL;
+smgr_extend_hook_type smgr_extend_hook = NULL;
+
 /* local function prototypes */
+static PgAioResult smgr_readv_complete(PgAioHandle *ioh,
+									   PgAioResult prior_result,
+									   uint8 cb_data);
+static void smgr_readv_report(PgAioResult result, const PgAioTargetData *td,
+							  int elevel);
 static void smgrshutdown(int code, Datum arg);
 static void smgrdestroy(SMgrRelation reln);
 
@@ -175,6 +186,12 @@ const PgAioTargetInfo aio_smgr_target_info = {
 	.describe_identity = smgr_aio_describe_identity,
 };
 
+/* AIO callback that calls smgr_read_hook for asynchronous reads */
+const PgAioHandleCallbacks aio_smgr_readv_cb = {
+	.complete_shared = smgr_readv_complete,
+	.report = smgr_readv_report,
+};
+
 
 /*
  * smgrinit(), smgrshutdown() -- Initialize or shut down storage
@@ -622,6 +639,10 @@ smgrextend(SMgrRelation reln, ForkNumber forknum, BlockNumber blocknum,
 {
 	HOLD_INTERRUPTS();
 
+	/* Let an extension transform the block (e.g. encrypt it) */
+	if (smgr_extend_hook)
+		buffer = smgr_extend_hook(reln, forknum, blocknum, buffer);
+
 	smgrsw[reln->smgr_which].smgr_extend(reln, forknum, blocknum,
 										 buffer, skipFsync);
 
@@ -721,10 +742,24 @@ void
 smgrreadv(SMgrRelation reln, ForkNumber forknum, BlockNumber blocknum,
 		  void **buffers, BlockNumber nblocks)
 {
+	BlockNumber done = nblocks;
+
 	HOLD_INTERRUPTS();
 	smgrsw[reln->smgr_which].smgr_readv(reln, forknum, blocknum, buffers,
 										nblocks);
+
+	/* Let an extension transform the blocks (e.g. decrypt them) */
+	if (smgr_read_hook)
+		done = smgr_read_hook(reln->smgr_rlocator, forknum, blocknum,
+							  buffers, nblocks);
 	RESUME_INTERRUPTS();
+
+	if (done < nblocks)
+		ereport(ERROR,
+				(errcode(ERRCODE_DATA_CORRUPTED),
+				 errmsg("could not transform block %u in file \"%s\" after reading it",
+						blocknum + done,
+						relpath(reln->smgr_rlocator, forknum).str)));
 }
 
 /*
@@ -755,12 +790,114 @@ smgrstartreadv(PgAioHandle *ioh,
 			   void **buffers, BlockNumber nblocks)
 {
 	HOLD_INTERRUPTS();
+
+	/*
+	 * Let an extension transform the blocks (e.g. decrypt them) when the read
+	 * completes.  Completion callbacks run in the reverse order of
+	 * registration, so this one runs after the one that the smgr
+	 * implementation registers below (which turns the result into a number of
+	 * blocks), and before the one that the caller registered earlier (which,
+	 * in the buffer manager, verifies the page checksums).
+	 */
+	if (smgr_read_hook)
+		pgaio_io_register_callbacks(ioh, PGAIO_HCB_SMGR_READV, 0);
+
 	smgrsw[reln->smgr_which].smgr_startreadv(ioh,
 											 reln, forknum, blocknum, buffers,
 											 nblocks);
 	RESUME_INTERRUPTS();
 }
 
+/*
+ * AIO completion callback for smgrstartreadv(), registered when
+ * smgr_read_hook is set.  It passes the blocks that were read to the hook.
+ *
+ * Like all completion callbacks this runs in a critical section, and possibly
+ * in a different process than the one that started the read, so it has only
+ * the IO handle to work with: the buffers come from its iovecs, and the
+ * relation from its target data.
+ */
+static PgAioResult
+smgr_readv_complete(PgAioHandle *ioh, PgAioResult prior_result, uint8 cb_data)
+{
+	PgAioTargetData *td = pgaio_io_get_target_data(ioh);
+	PgAioResult result = prior_result;
+	RelFileLocatorBackend rlocator;
+	void	   *buffers[PG_IOV_MAX];
+	BlockNumber nblocks = 0;
+	BlockNumber done;
+	struct iovec *iov;
+	int			iovcnt;
+
+	/*
+	 * The smgr implementation has already turned the result into a number of
+	 * blocks and reported any error.  Nothing to do if the read failed, or if
+	 * the hook was not set in this process (it is set by modules loaded with
+	 * shared_preload_libraries, so it is the same in all processes).
+	 */
+	if (prior_result.status == PGAIO_RS_ERROR || smgr_read_hook == NULL)
+		return prior_result;
+
+	/*
+	 * Collect the addresses of the blocks that were read.  Adjacent buffers
+	 * may have been combined into one iovec; after a partial read, only the
+	 * first prior_result.result blocks are valid.
+	 */
+	iovcnt = pgaio_io_get_iovec_length(ioh, &iov);
+	for (int i = 0; i < iovcnt; i++)
+	{
+		for (size_t off = 0; off < iov[i].iov_len; off += BLCKSZ)
+		{
+			if (nblocks >= (BlockNumber) prior_result.result)
+				break;
+			Assert(nblocks < lengthof(buffers));
+			buffers[nblocks++] = (char *) iov[i].iov_base + off;
+		}
+	}
+
+	rlocator.locator = td->smgr.rlocator;
+	rlocator.backend = td->smgr.is_temp ? pgaio_io_get_owner(ioh) :
+		INVALID_PROC_NUMBER;
+
+	done = smgr_read_hook(rlocator, td->smgr.forkNum, td->smgr.blockNum,
+						  buffers, nblocks);
+
+	if (done < nblocks)
+	{
+		/*
+		 * Fail the whole read.  error_data is the offset of the block that
+		 * the hook could not process.  As in md.c, log the problem right
+		 * away; the process that started the read raises the error when it
+		 * looks at the result.
+		 */
+		result.status = PGAIO_RS_ERROR;
+		result.id = PGAIO_HCB_SMGR_READV;
+		result.error_data = done;
+		pgaio_result_report(result, td, LOG_SERVER_ONLY);
+	}
+
+	return result;
+}
+
+/*
+ * AIO error reporting callback for smgr_readv_complete().
+ */
+static void
+smgr_readv_report(PgAioResult result, const PgAioTargetData *td, int elevel)
+{
+	RelPathStr	path;
+
+	path = relpathbackend(td->smgr.rlocator,
+						  td->smgr.is_temp ? MyProcNumber : INVALID_PROC_NUMBER,
+						  td->smgr.forkNum);
+
+	ereport(elevel,
+			errcode(ERRCODE_DATA_CORRUPTED),
+			errmsg("could not transform block %u in file \"%s\" after reading it",
+				   td->smgr.blockNum + result.error_data,
+				   path.str));
+}
+
 /*
  * smgrwritev() -- Write the supplied buffers out.
  *
@@ -792,6 +929,11 @@ smgrwritev(SMgrRelation reln, ForkNumber forknum, BlockNumber blocknum,
 		   const void **buffers, BlockNumber nblocks, bool skipFsync)
 {
 	HOLD_INTERRUPTS();
+
+	/* Let an extension transform the blocks (e.g. encrypt them) */
+	if (smgr_write_hook)
+		buffers = smgr_write_hook(reln, forknum, blocknum, buffers, nblocks);
+
 	smgrsw[reln->smgr_which].smgr_writev(reln, forknum, blocknum,
 										 buffers, nblocks, skipFsync);
 	RESUME_INTERRUPTS();
