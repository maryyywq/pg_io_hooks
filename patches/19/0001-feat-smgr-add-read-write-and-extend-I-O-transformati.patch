index ec543b78409..93048f55f1c 100644
--- a/src/include/storage/aio.h
+++ b/src/include/storage/aio.h
@@ -195,6 +195,8 @@ typedef enum PgAioHandleCallbackID
 
 	PGAIO_HCB_MD_READV,
 
+	PGAIO_HCB_SMGR_READV,
+
 	PGAIO_HCB_SHARED_BUFFER_READV,
 
 	PGAIO_HCB_LOCAL_BUFFER_READV,
diff --git a/src/include/storage/smgr.h b/src/include/storage/smgr.h
index 09bd42fcf4b..014b1b42768 100644
--- a/src/include/storage/smgr.h
+++ b/src/include/storage/smgr.h
@@ -76,6 +76,93 @@ typedef SMgrRelationData *SMgrRelation;
 
 extern PGDLLIMPORT const PgAioTargetInfo aio_smgr_target_info;
 
+/*
+ * Storage I/O transformation hooks.
+ *
+ * These hooks let an extension (loaded via shared_preload_libraries) observe
+ * or transform block data on its way to and from the storage manager, for
+ * example to implement transparent page encryption.  Each hook is optional;
+ * when it is NULL, the behavior is identical to a server without hooks.
+ *
+ * Hooks are called from any process that performs relation I/O: backends,
+ * the background writer, the checkpointer, the startup process and, for the
+ * read hook, I/O workers.
+ *
+ * Registration follows the usual PostgreSQL convention: an extension saves
+ * the previous value of the hook variable in _PG_init() and calls it from its
+ * own hook.  Only one extension may actually change data.  Any other hook
+ * must be a pass-through: it calls the previous hook, may observe the data,
+ * and returns what the previous hook returned.
+ *
+ * Checksums are not the hooks' concern.  The core computes a page checksum
+ * before the write hook runs and verifies it after the read hook has run, so
+ * both always see the untransformed (plaintext) page image.
+ *
+ * Except for the read hook, which has stricter rules (see below), errors are
+ * reported with ereport(ERROR).  A hook must not modify the buffers passed to
+ * the write and extend hooks, because they may be shared buffers.
+ */
+
+/*
+ * smgr_read_hook_type: called after "nblocks" blocks starting at "blocknum"
+ * have been read into "buffers", before their checksums are verified and
+ * before the caller looks at them.  The hook may transform the blocks in
+ * place (e.g. decrypt them).
+ *
+ * The hook returns the number of leading blocks it has processed
+ * successfully, which is "nblocks" unless something went wrong.  A smaller
+ * value makes the read fail with an error that names block
+ * "blocknum + result".  A hook that chains to a previous one processes, and
+ * returns at most, the number of blocks that the previous hook returned.
+ *
+ * The hook is called both for synchronous reads (smgrreadv()) and for
+ * asynchronous ones (smgrstartreadv(), which the buffer manager uses).  For
+ * the latter it runs in the completion callback of the read, in a critical
+ * section, and possibly in another process (an I/O worker or another backend)
+ * than the one that started the read.  Therefore the read hook must not raise
+ * ERROR or allocate memory, and may rely only on state set up in _PG_init()
+ * and on shared memory.  For the same reason it receives the relation file
+ * locator rather than an SMgrRelation.  For a partially successful read, the
+ * hook only sees the blocks that were actually read; the caller reads the
+ * rest with another call.
+ */
+typedef BlockNumber (*smgr_read_hook_type) (RelFileLocatorBackend rlocator,
+											ForkNumber forknum,
+											BlockNumber blocknum,
+											void **buffers,
+											BlockNumber nblocks);
+
+/*
+ * smgr_write_hook_type: called by smgrwritev() before the blocks are written.
+ * Returns the array of buffers that must actually be written.  The hook must
+ * return the input array unchanged if it does not transform the data.
+ *
+ * Otherwise, the returned array and the buffers it points to are owned by the
+ * hook, must be aligned to PG_IO_ALIGN_SIZE, and must stay valid until the
+ * next call of any smgr write hook in the same process.  The hook must be
+ * prepared for up to MAX_IO_COMBINE_LIMIT blocks per call.  Memory should be
+ * allocated in advance (e.g. in _PG_init()) rather than in the hook.
+ */
+typedef const void **(*smgr_write_hook_type) (SMgrRelation reln,
+											  ForkNumber forknum,
+											  BlockNumber blocknum,
+											  const void **buffers,
+											  BlockNumber nblocks);
+
+/*
+ * smgr_extend_hook_type: the single-block counterpart of the write hook,
+ * called by smgrextend().  The same rules for the returned buffer apply.
+ */
+typedef const void *(*smgr_extend_hook_type) (SMgrRelation reln,
+											  ForkNumber forknum,
+											  BlockNumber blocknum,
+											  const void *buffer);
+
+extern PGDLLIMPORT smgr_read_hook_type smgr_read_hook;
+extern PGDLLIMPORT const PgAioHandleCallbacks aio_smgr_readv_cb;
+extern PGDLLIMPORT smgr_write_hook_type smgr_write_hook;
+extern PGDLLIMPORT smgr_extend_hook_type smgr_extend_hook;
+
 extern void smgrinit(void);
 extern SMgrRelation smgropen(RelFileLocator rlocator, ProcNumber backend);
 extern bool smgrexists(SMgrRelation reln, ForkNumber forknum);

