From 903f8be7079100b2efa36220be7c7d18045f6b55 Mon Sep 17 00:00:00 2001
From: Maria <mk902589@yandex.ru>
Date: Fri, 13 Nov 2026 00:17:55 +0700
Subject: [PATCH 1/6] feat(smgr): add read, write and extend I/O transformation
 hooks

Add smgr_read_hook, smgr_write_hook and smgr_extend_hook, called from
smgrreadv(), smgrwritev() and smgrextend().  An extension can use them
to transform block data on its way to and from the storage manager, for
example to implement transparent page encryption.

The read hook gets the relation file locator instead of an SMgrRelation
and reports failures through its return value instead of raising an
error.  This keeps its API the same as on servers with asynchronous I/O,
where it runs in an I/O completion callback.

The hooks follow the usual chaining convention.  Page checksums are
computed before the write hook and verified after the read hook, so
hooks always see the plaintext page.  With no hook registered the
behavior is unchanged.
---
 src/backend/storage/smgr/smgr.c | 28 ++++++++++
 src/include/storage/smgr.h      | 95 +++++++++++++++++++++++++++++++++
 2 files changed, 123 insertions(+)

diff --git a/src/backend/storage/smgr/smgr.c b/src/backend/storage/smgr/smgr.c
index 1344316ee2c..d20c653b9be 100644
--- a/src/backend/storage/smgr/smgr.c
+++ b/src/backend/storage/smgr/smgr.c
@@ -137,6 +137,11 @@ static HTAB *SMgrRelationHash = NULL;
 
 static dlist_head unpinned_relns;
 
+/* Storage I/O transformation hooks, see smgr.h */
+smgr_read_hook_type smgr_read_hook = NULL;
+smgr_write_hook_type smgr_write_hook = NULL;
+smgr_extend_hook_type smgr_extend_hook = NULL;
+
 /* local function prototypes */
 static void smgrshutdown(int code, Datum arg);
 static void smgrdestroy(SMgrRelation reln);
@@ -535,6 +540,10 @@ void
 smgrextend(SMgrRelation reln, ForkNumber forknum, BlockNumber blocknum,
 		   const void *buffer, bool skipFsync)
 {
+	/* Let an extension transform the block (e.g. encrypt it) */
+	if (smgr_extend_hook)
+		buffer = smgr_extend_hook(reln, forknum, blocknum, buffer);
+
 	smgrsw[reln->smgr_which].smgr_extend(reln, forknum, blocknum,
 										 buffer, skipFsync);
 
@@ -602,6 +611,21 @@ smgrreadv(SMgrRelation reln, ForkNumber forknum, BlockNumber blocknum,
 {
 	smgrsw[reln->smgr_which].smgr_readv(reln, forknum, blocknum, buffers,
 										nblocks);
+
+	/* Let an extension transform the blocks (e.g. decrypt them) */
+	if (smgr_read_hook)
+	{
+		BlockNumber done;
+
+		done = smgr_read_hook(reln->smgr_rlocator, forknum, blocknum,
+							  buffers, nblocks);
+		if (done < nblocks)
+			ereport(ERROR,
+					(errcode(ERRCODE_DATA_CORRUPTED),
+					 errmsg("could not transform block %u in file \"%s\" after reading it",
+							blocknum + done,
+							relpath(reln->smgr_rlocator, forknum))));
+	}
 }
 
 /*
@@ -631,6 +655,10 @@ void
 smgrwritev(SMgrRelation reln, ForkNumber forknum, BlockNumber blocknum,
 		   const void **buffers, BlockNumber nblocks, bool skipFsync)
 {
+	/* Let an extension transform the blocks (e.g. encrypt them) */
+	if (smgr_write_hook)
+		buffers = smgr_write_hook(reln, forknum, blocknum, buffers, nblocks);
+
 	smgrsw[reln->smgr_which].smgr_writev(reln, forknum, blocknum,
 										 buffers, nblocks, skipFsync);
 }
diff --git a/src/include/storage/smgr.h b/src/include/storage/smgr.h
index 3856d1d4f8b..4c8b4dcc78b 100644
--- a/src/include/storage/smgr.h
+++ b/src/include/storage/smgr.h
@@ -73,6 +73,101 @@ typedef SMgrRelationData *SMgrRelation;
 #define SmgrIsTemp(smgr) \
 	RelFileLocatorBackendIsTemp((smgr)->smgr_rlocator)
 
+/*
+ * Storage I/O transformation hooks.
+ *
+ * These hooks let an extension (loaded via shared_preload_libraries) observe
+ * or transform block data on its way to and from the storage manager, for
+ * example to implement transparent page encryption.  Each hook is optional;
+ * when it is NULL, the behavior is identical to a server without hooks.
+ *
+ * Hooks are called from any process that performs relation I/O: backends,
+ * the background writer, the checkpointer and the startup process.
+ *
+ * Registration follows the usual PostgreSQL convention: an extension saves
+ * the previous value of the hook variable in _PG_init() and calls it from its
+ * own hook.  Only one extension may actually change data.  Any other hook
+ * must be a pass-through: it calls the previous hook, may observe the data,
+ * and returns what the previous hook returned.
+ *
+ * Checksums are not the hooks' concern.  The core computes a page checksum
+ * before the write hook runs and verifies it after the read hook has run, so
+ * both always see the untransformed (plaintext) page image.
+ *
+ * Except for the read hook, which has stricter rules (see below), errors are
+ * reported with ereport(ERROR).  A hook must not modify the buffers passed to
+ * the write and extend hooks, because they may be shared buffers.
+ */
+
+/*
+ * Version of the hooks API, for extensions to check at compile time:
+ *
+ *   #if !defined(SMGR_HOOKS_API_VERSION) || SMGR_HOOKS_API_VERSION < 2
+ *   #error "this extension needs a server with the smgr hooks"
+ *   #endif
+ *
+ * Version 2 is the API described here.  (Version 1 differed only in the
+ * read hook, which took an SMgrRelation, returned nothing and could raise
+ * ERROR; it was never released.)
+ */
+#define SMGR_HOOKS_API_VERSION 2
+
+/*
+ * smgr_read_hook_type: called after "nblocks" blocks starting at "blocknum"
+ * have been read into "buffers", before their checksums are verified and
+ * before the caller looks at them.  The hook may transform the blocks in
+ * place (e.g. decrypt them).
+ *
+ * The hook returns the number of leading blocks it has processed
+ * successfully, which is "nblocks" unless something went wrong.  A smaller
+ * value makes the read fail with an error that names block
+ * "blocknum + result".  A hook that chains to a previous one processes, and
+ * returns at most, the number of blocks that the previous hook returned.
+ *
+ * The read hook must not raise ERROR or allocate memory, and may rely only on
+ * state set up in _PG_init() and on shared memory.  This keeps the API the
+ * same on servers with asynchronous I/O (PostgreSQL 18 and later), where the
+ * hook runs in the completion callback of a read: in a critical section, and
+ * possibly in another process (an I/O worker or another backend) than the
+ * one that started the read.  For the same reason the hook receives the
+ * relation file locator rather than an SMgrRelation.
+ */
+typedef BlockNumber (*smgr_read_hook_type) (RelFileLocatorBackend rlocator,
+											ForkNumber forknum,
+											BlockNumber blocknum,
+											void **buffers,
+											BlockNumber nblocks);
+
+/*
+ * smgr_write_hook_type: called by smgrwritev() before the blocks are written.
+ * Returns the array of buffers that must actually be written.  The hook must
+ * return the input array unchanged if it does not transform the data.
+ *
+ * Otherwise, the returned array and the buffers it points to are owned by the
+ * hook, must be aligned to PG_IO_ALIGN_SIZE, and must stay valid until the
+ * next call of any smgr write hook in the same process.  The hook must be
+ * prepared for up to MAX_IO_COMBINE_LIMIT blocks per call.  Memory should be
+ * allocated in advance (e.g. in _PG_init()) rather than in the hook.
+ */
+typedef const void **(*smgr_write_hook_type) (SMgrRelation reln,
+											  ForkNumber forknum,
+											  BlockNumber blocknum,
+											  const void **buffers,
+											  BlockNumber nblocks);
+
+/*
+ * smgr_extend_hook_type: the single-block counterpart of the write hook,
+ * called by smgrextend().  The same rules for the returned buffer apply.
+ */
+typedef const void *(*smgr_extend_hook_type) (SMgrRelation reln,
+											  ForkNumber forknum,
+											  BlockNumber blocknum,
+											  const void *buffer);
+
+extern PGDLLIMPORT smgr_read_hook_type smgr_read_hook;
+extern PGDLLIMPORT smgr_write_hook_type smgr_write_hook;
+extern PGDLLIMPORT smgr_extend_hook_type smgr_extend_hook;
+
 extern void smgrinit(void);
 extern SMgrRelation smgropen(RelFileLocator rlocator, ProcNumber backend);
 extern bool smgrexists(SMgrRelation reln, ForkNumber forknum);

